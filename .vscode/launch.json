{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Part 1 - Check sources (robots.txt + terms)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/part1_check_sources.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Part 1 - EDGAR pull: DRY RUN (list only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/part1_edgar_pull.py",
      "args": [
        "--dry-run"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Part 1 - EDGAR pull: JPMorgan only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/part1_edgar_pull.py",
      "args": [
        "--firms",
        "jpm"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Part 1 - EDGAR pull: all firms",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/part1_edgar_pull.py",
