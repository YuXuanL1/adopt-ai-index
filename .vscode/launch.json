      "console": "integratedTerminal",
      "name": "Part 1.5 - Firm universe: all firms"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/part15_build_universe.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "name": "Part 1.5 - Firm universe: JPMorgan only",
      "args": [
        "--firms",
        "jpm"
      ]
    },
    {
      "type": "debugpy",
      "request": "launch",
